# Safety net for hosts where the document root cannot point to public/.
# Every request is sent into public/, so nothing else in this folder
# (.env, vendor/, storage/, source code) can ever be downloaded.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>
