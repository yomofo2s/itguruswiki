# ---------------------------------------------------------------------------
# IT GURUs Germany - environment configuration
# Local development defaults below. Production values: docs/HOSTING.md
# Never commit the real .env file.
# ---------------------------------------------------------------------------
APP_NAME="IT GURUs Germany"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite (zero setup). Production: mariadb (see docs/HOSTING.md)
DB_CONNECTION=sqlite
# DB_CONNECTION=mariadb
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=itgurus
# DB_USERNAME=itgurus
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Local: mails are written to storage/logs. Use Mailpit (compose.yaml) with MAIL_MAILER=smtp, MAIL_PORT=1025.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@itgurusgermany.com"
MAIL_FROM_NAME="${APP_NAME}"

# Site settings (config/itgurus.php)
ITG_CONTACT_EMAIL=info@itgurusgermany.com
ITG_NOTIFY_EMAIL=info@itgurusgermany.com
ITG_SOCIAL_WHATSAPP=
ITG_SOCIAL_TELEGRAM=
ITG_SOCIAL_LINKEDIN=
ITG_SOCIAL_INSTAGRAM=
ITG_SOCIAL_GITHUB=https://github.com/yomofo2s/itguruswiki

VITE_APP_NAME="${APP_NAME}"
